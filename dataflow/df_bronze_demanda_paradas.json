{
	"name": "df_bronze_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				},
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fec_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          abordajes_manuales as string,",
				"          descensos_manuales as string,",
				"          demanda_no_atendida as string,",
				"          medicion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          fecha_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          estimacion_abordajes as string,",
				"          estimacion_descensos as string,",
				"          demanda_no_atendida as string,",
				"          metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"          fecha_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          estimacion_abordajes as string,",
				"          estimacion_descensos as string,",
				"          demanda_no_atendida as string,",
				"          metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2023",
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv select(mapColumn(",
				"          FechaServicio = fec_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          ValidacionesTarjeta = abordajes_manuales,",
				"          Descensos = descensos_manuales,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = medicion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"xls2022 select(mapColumn(",
				"          FechaServicio = fecha_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          ValidacionesTarjeta = estimacion_abordajes,",
				"          Descensos = estimacion_descensos,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = metodo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xls2023 select(mapColumn(",
				"          FechaServicio = fecha_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          ValidacionesTarjeta = estimacion_abordajes,",
				"          Descensos = estimacion_descensos,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = metodo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select2, sql, select3 union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}