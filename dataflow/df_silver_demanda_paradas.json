{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "numerarFilas"
				},
				{
					"name": "limpiarTextos"
				},
				{
					"name": "convertirNumeros"
				},
				{
					"name": "convertirFecha"
				},
				{
					"name": "equivalenciaIds"
				},
				{
					"name": "soloValidos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"sql keyGenerate(output(NumFila as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> numerarFilas",
				"numerarFilas derive(Franja = coalesce(trim(Franja), 'SIN DATO'),",
				"          Metodo = coalesce(upper(trim(Metodo)), 'SIN DATO')) ~> limpiarTextos",
				"limpiarTextos derive(ValidacionesTarjeta = coalesce(toInteger(toDouble(replace(trim(ValidacionesTarjeta), ',', '.'))), 0),",
				"          Descensos = coalesce(toInteger(toDouble(replace(trim(Descensos), ',', '.'))), 0),",
				"          DemandaNoAtendida = coalesce(toInteger(toDouble(replace(trim(DemandaNoAtendida), ',', '.'))), 0)) ~> convertirNumeros",
				"convertirNumeros derive(FechaServicio = case(regexMatch(trim(FechaServicio), '^[0-9]{4}-[0-9]{2}-[0-9]{2}.*'), toDate(left(trim(FechaServicio), 10), 'yyyy-MM-dd'), regexMatch(trim(FechaServicio), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(FechaServicio), 'dd/MM/yyyy'), regexMatch(trim(FechaServicio), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4} .*'), toDate(split(trim(FechaServicio), ' ')[1], 'M/d/yyyy'), regexMatch(trim(FechaServicio), '^[0-9]{5}([.]0+)?$'), addDays(toDate('1899-12-30'), toInteger(toDouble(trim(FechaServicio)))))) ~> convertirFecha",
				"convertirFecha derive(RutaHistoricaId = case(trim(coalesce(RutaHistoricaId, '')) == '', toString(null()), startsWith(upper(trim(RutaHistoricaId)), 'RH-'), upper(trim(RutaHistoricaId)), startsWith(upper(trim(RutaHistoricaId)), 'R12-N'), 'RH-12-N', startsWith(upper(trim(RutaHistoricaId)), 'R12-S'), 'RH-12-S', lpad(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''), 2, '0') == '07', iif(year(FechaServicio) < 2024, 'RH-07-OLD', 'RH-07-NEW'), lpad(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''), 2, '0') == '12', 'RH-12-OLD', concat('RH-', lpad(regexReplace(trim(RutaHistoricaId), '[^0-9]', ''), 2, '0'))),",
				"          ParadaHistoricaId = iif(upper(trim(ParadaHistoricaId)) == 'MC-01', iif(FechaServicio >= toDate('2023-07-01'), 'P220-MC-NEW', 'P220-MC-OLD'), upper(trim(ParadaHistoricaId))),",
				"          DemandaId = iif(trim(coalesce(DemandaId, '')) == '', concat('DM-', toString(year(FechaServicio)), '-X', lpad(toString(NumFila), 6, '0')), upper(trim(DemandaId)))) ~> equivalenciaIds",
				"equivalenciaIds filter(!isNull(FechaServicio) && !isNull(RutaHistoricaId) && !isNull(ParadaHistoricaId) && Franja != 'SIN DATO') ~> soloValidos",
				"soloValidos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}