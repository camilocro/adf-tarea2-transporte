{
	"name": "df_silver_incidente_ruta",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "limpiarYConvertir"
				},
				{
					"name": "quitarDuplicados"
				},
				{
					"name": "soloValidos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"sql derive(IncidenteId = upper(trim(IncidenteId)),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          EsPrincipal = iif(lower(trim(EsPrincipal)) == 'true' || trim(EsPrincipal) == '1', true(), false())) ~> limpiarYConvertir",
				"limpiarYConvertir window(over(IncidenteId,",
				"          RutaHistoricaId),",
				"     desc(EsPrincipal, true),",
				"     NumFila = rowNumber()) ~> quitarDuplicados",
				"quitarDuplicados filter(NumFila == 1 && !isNull(IncidenteId) && RutaHistoricaId != '') ~> soloValidos",
				"soloValidos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}