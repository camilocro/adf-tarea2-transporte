{
	"name": "df_bronze_incidentes",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_incidentes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2023"
				},
				{
					"dataset": {
						"referenceName": "bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "unirFechaHoraCsv"
				},
				{
					"name": "unirFechaHoraCsv2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2022",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2023",
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"csv derive(FechaHoraInicio = concat(coalesce(fecha_inicio, ''), '|', coalesce(hora_inicio, '')),",
				"          FechaHoraFin = concat(coalesce(fecha_fin, ''), '|', coalesce(hora_fin, ''))) ~> unirFechaHoraCsv",
				"xls2022 derive(FechaHoraInicio = concat(coalesce(fecha_inicio, ''), '|', coalesce(hora_inicio, '')),",
				"          FechaHoraFin = concat(coalesce(fecha_fin, ''), '|', coalesce(hora_fin, ''))) ~> unirFechaHoraCsv2",
				"xls2023 derive(FechaHoraInicio = concat(coalesce(fecha_inicio, ''), '|', coalesce(hora_inicio, '')),",
				"          FechaHoraFin = concat(coalesce(fecha_fin, ''), '|', coalesce(hora_fin, ''))) ~> derivedColumn1",
				"unirFechaHoraCsv select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion,",
				"          FechaHoraInicio,",
				"          FechaHoraFin",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"unirFechaHoraCsv2 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion,",
				"          FechaHoraInicio,",
				"          FechaHoraFin",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn1 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          FechaHoraRegistro = fecha_registro,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion,",
				"          FechaHoraInicio,",
				"          FechaHoraFin",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select2, select3, sql union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}